        "jsCode": "const agentResponse = $input.first().json.output;\n\nlet parsed;\ntry {\n  const clean = agentResponse.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch(e) {\n  parsed = {\n    modulo: \"Não identificado\",\n    processo: \"Não identificado\",\n    interpretacao: agentResponse,\n    informacoes_faltantes: null,\n    solicitar_mais_informacoes: false,\n    causas_possiveis: \"Não foi possível processar a resposta\",\n    proximos_passos: \"Contate o suporte técnico\",\n    transacoes_envolvidas: null,\n    fontes_consultadas: \"Base de conhecimento SAP MM\",\n    nivel_confianca: \"BAIXO\",\n    requer_aprovacao_humana: true,\n    motivo_aprovacao_humana: \"Erro no processamento da resposta\"\n  };\n}\n\nreturn [{\n  json: {\n    ticket_id: $('ticket_processing').item.json.ticket_id,\n    sistema: $('ticket_processing').item.json.sistema,\n    chamado_texto: $('ticket_processing').item.json.chamado_texto,\n    usuario: $('ticket_processing').item.json.usuario,\n    prioridade: $('ticket_processing').item.json.prioridade,\n    ...parsed\n  }\n}];"
