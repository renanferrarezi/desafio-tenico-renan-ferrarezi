        "jsCode": "const body = $input.first().json.body;\n\nreturn [{\n  json: {\n    chamado_id: $execution.id,\n    ticket_id: body.ticket_id || \"não informado\",\n    sistema: body.sistema || \"SAP\",\n    modulo: body.modulo || \"não informado\",\n    chamado_texto: body.chamado,\n    usuario: body.usuario || \"não informado\",\n    prioridade: body.prioridade || \"normal\"\n  }\n}];"
