        "jsCode": "const item = $input.first();\nconst body = item.json.body;\n\nconst ignorar = ['pinecone-namespace', 'pinecone-index'];\nconst metadata = {};\n\nfor (const [key, value] of Object.entries(body)) {\n  if (!ignorar.includes(key)) {\n    metadata[key] = value;\n  }\n}\n\n// ID baseado no nome do arquivo — sem espaços e minúsculo\nconst fileName = item.json.body['file-name'] ?? \n                 item.binary?.data?.fileName ?? \n                 'documento';\n\nconst docId = fileName\n  .toLowerCase()\n  .replace(/\\s+/g, '-')\n  .replace(/\\.[^.]+$/, ''); // remove extensão\n\nreturn [{\n  json: {\n    ...item.json,\n    pineconeNamespace: body['pinecone-namespace'],\n    pineconeIndex: body['pinecone-index'],\n    docId,   // ex: \"sap-business-one\"\n    metadata: { ...metadata, docId }  // salva docId no metadata também\n  },\n  binary: item.binary\n}];"
      },
